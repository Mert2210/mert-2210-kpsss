# Firebase + App configuration
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file – it is in .gitignore.

# ── Firebase project credentials ──────────────────────────────
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ── Application settings ───────────────────────────────────────
# Firestore path prefix used everywhere as: artifacts/{VITE_APP_ID}/...
VITE_APP_ID=huzurbahcesi-v1

# Optional: supply a Firebase custom-auth token to pre-authenticate
# a server-rendered session.  Leave blank for anonymous sign-in.
VITE_INITIAL_AUTH_TOKEN=
